# ============================================================
# Circle Accountability — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# Never commit .env or .env.local files.
# ============================================================

# --- Database ---
DATABASE_URL=postgres://postgres:password@localhost:5432/circle_accountability

# --- API ---
API_PORT=8080
API_ENV=development  # development | staging | production

# --- Auth (Clerk) ---
# Get these from https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Web App (Next.js) ---
# These are prefixed with NEXT_PUBLIC_ so they're available in the browser
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# --- Mobile App (Expo) ---
# These are prefixed with EXPO_PUBLIC_ so they're available in the app
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
