# ============================================================
# Circle Accountability — API Environment Variables
# Copy this file to .env.local in the repo root and fill in values.
# This file is read by the Go API via godotenv (see apps/api/cmd/api/main.go).
# Web and mobile each have their own .env.example in their app directory.
# Never commit .env or .env.local files.
# ============================================================

# --- Database ---
# sslmode=disable is required for local Docker Postgres (SSL is not enabled in the container).
# In production on Neon/Cloud SQL, use sslmode=require instead.
DATABASE_URL=postgres://postgres:password@localhost:5432/circle_accountability?sslmode=disable

# --- API ---
API_PORT=8090
API_ENV=development  # development | staging | production

# --- Auth (Clerk) ---
# The API only needs the secret key. It uses this to verify Clerk session
# tokens on incoming requests. Get it from https://dashboard.clerk.com
# under "API keys". Never expose this to any client.
CLERK_SECRET_KEY=sk_test_...
