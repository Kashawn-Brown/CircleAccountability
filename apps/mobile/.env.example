# ============================================================
# Circle Accountability — Mobile (Expo) Environment Variables
# Copy this file to apps/mobile/.env.local and fill in values.
# Expo auto-loads this file when you run `npx expo start` from apps/mobile/.
# Variables prefixed EXPO_PUBLIC_ are inlined into the app bundle and
# available at runtime via process.env.EXPO_PUBLIC_*.
# ============================================================

# --- API ---
# Where the app calls the Go API from the device.
# Note: a real iPhone running Expo Go cannot reach localhost on your Mac/PC.
# Replace localhost with your computer's LAN IP once we start making API calls
# (step 6 of the Phase 1 plan). Example: http://192.168.1.42:8090
EXPO_PUBLIC_API_URL=http://localhost:8090

# --- Auth (Clerk) ---
# Publishable key is safe to ship in the app bundle — it identifies the Clerk app.
# The mobile app never sees the Clerk secret key; token verification happens
# on the Go API, not on the device.
# Get the publishable key from https://dashboard.clerk.com under "API keys".
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
