# ============================================================
# Circle Accountability — Web (Next.js) Environment Variables
# Copy this file to apps/web/.env.local and fill in values.
# Next.js auto-loads this file when you run `npm run dev` from apps/web/.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser bundle;
# everything else stays server-side only.
# ============================================================

# --- API ---
# Where the Next.js app calls the Go API from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8090

# --- Auth (Clerk) ---
# Publishable key is safe to ship to the browser — it identifies the Clerk app.
# Secret key is used by Next.js server components and route handlers to verify
# sessions. Never expose the secret key to the client.
# Get both from https://dashboard.clerk.com under "API keys".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Tell Clerk's middleware and prebuilt components where our own sign-in /
# sign-up pages live. Without these, auth.protect() in middleware falls
# back to Clerk's hosted accounts.dev portal instead of our local routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
